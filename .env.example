# ============================================
# SybTech Environment Variables Template
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Webhooks & Notifications
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Calendar API (JSON service account credentials path)
GOOGLE_CALENDAR_CREDENTIALS=./config/google-credentials.json
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com

# Feature Flags (Core)
ENABLE_VOICE_RESPONSES=false
ENABLE_AB_TESTING=false
ENABLE_ANALYTICS_DASHBOARD=true
ENABLE_SESSION_MEMORY=true
ENABLE_LEAD_SCORING=true
ENABLE_RATE_LIMITING=true

# Feature Flags (New Upgrades)
ENABLE_BROADCAST_SCHEDULER=true     # Auto-schedule broadcast campaigns on startup
ENABLE_MULTI_NUMBER=false           # Set true + define WHATSAPP_NUMBERS to use multi-number
ENABLE_GROUP_SUPPORT=true           # Bot responds in groups when @mentioned

# Bot Configuration & Human Behavior
BOT_NAME=محمد
MIN_DELAY_SECONDS=5
MAX_DELAY_SECONDS=30

# Security & Rate Limiting
MAX_MESSAGES_PER_HOUR=50
SPAM_THRESHOLD=10

# Dashboard Security (run: npm run generate-key)
DASHBOARD_API_KEY=generate-secure-key-with-npm-run-generate-key
DASHBOARD_PORT=3000

# Team Configuration
TEAM_WHATSAPP_NUMBER=+971501234567
TELEGRAM_CHAT_ID=your-telegram-chat-id

# CRM (optional: push leads to external CRM via webhook)
CRM_WEBHOOK_URL=

# Multi-Number Support (comma-separated labels, e.g. sales,support)
# Each label needs its own WhatsApp scan on first launch
WHATSAPP_NUMBERS=

# CORS (production only)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Rate Limiting Configuration (Web App)
RATE_LIMIT_CHAT=60 per minute
RATE_LIMIT_CONTACT=30 per minute
